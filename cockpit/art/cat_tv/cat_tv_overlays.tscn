code = "shader_type spatial;\nrender_mode unshaded;\nuniform float strength : hint_range(0.0, 1.0) = 1.0;   // gameplay may fade the static in/out\nuniform vec2 grain = vec2(96.0, 72.0);\nfloat hash(vec2 p) { return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453); }\nvoid fragment() {\n\tfloat n = hash(floor(UV * grain) + floor(TIME * 30.0));\n\tfloat roll = 0.8 + 0.2 * sin(UV.y * 180.0 + TIME * 25.0);\n\tALBEDO = vec3(n * roll) * vec3(0.92, 0.96, 1.0);\n\tALPHA = strength;\n}\n"

